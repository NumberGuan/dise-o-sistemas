    style Calle fill:#253247,stroke:#94a3b8,color:#f1f5f9,stroke-width:1.5px
    style Localidad fill:#253247,stroke:#94a3b8,color:#f1f5f9,stroke-width:1.5px
    style Provincia fill:#253247,stroke:#94a3b8,color:#f1f5f9,stroke-width:1.5px
    style PresupuestoProveedor fill:#39291e,stroke:#fb923c,color:#f1f5f9,stroke-width:1.5px
    style DetallePresupuestoProveedor fill:#39291e,stroke:#fb923c,color:#f1f5f9,stroke-width:1.5px
